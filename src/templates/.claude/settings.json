{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "python -B .claude/statusline.py"
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(python -B .claude/statusline.py:*)",
      "Bash(python tools/workstream.py:*)",
      "Bash(python -B tools/workstream.py:*)",
      "Bash(python3 tools/workstream.py:*)",
      "Bash(py tools/workstream.py:*)",
      "Bash(python tools/objective.py:*)",
      "Bash(python -B tools/objective.py:*)",
      "Bash(python3 tools/objective.py:*)",
      "Bash(py tools/objective.py:*)",
      "Bash(python tools/assignment.py:*)",
      "Bash(python -B tools/assignment.py:*)",
      "Bash(python3 tools/assignment.py:*)",
      "Bash(py tools/assignment.py:*)",
      "Bash(python tools/gate.py:*)",
      "Bash(python -B tools/gate.py:*)",
      "Bash(python3 tools/gate.py:*)",
      "Bash(py tools/gate.py:*)",
      "Bash(python tools/cadence.py:*)",
      "Bash(python -B tools/cadence.py:*)",
      "Bash(python3 tools/cadence.py:*)",
      "Bash(py tools/cadence.py:*)",
      "Bash(python tools/vault-lint.py:*)",
      "Bash(python -B tools/vault-lint.py:*)",
      "Bash(python3 tools/vault-lint.py:*)",
      "Bash(py tools/vault-lint.py:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Edit(control-plane/**)",
      "Write(control-plane/**)",
      "Edit(_harness/**)",
      "Write(_harness/**)",
      "Edit(outputs/**)",
      "Write(outputs/**)",
      "Edit(knowledge/**)",
      "Write(knowledge/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/secrets/**)"
    ]
  }
}
